# Copy to .env and adjust. Real environment variables override this file.

# ── Ollama ──────────────────────────────────────────────────────────────────
OLLAMA_HOST=http://127.0.0.1:11434
# Chat model. Falls back to an installed gemma4 model if this one is missing.
OLLAMA_MODEL=gemma4:e2b
# Multilingual; an existing nomic-embed-text index is re-embedded automatically
OLLAMA_EMBED_MODEL=embeddinggemma
# Image explainer needs a vision-capable model
OLLAMA_VISION_MODEL=gemma4:e4b
# Seconds before a request is abandoned; the first call also loads the model
OLLAMA_TIMEOUT=300
# How long Ollama keeps the model in RAM after a request (-1 = forever)
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=4096

# ── Storage (relative paths resolve against this folder) ────────────────────
CHROMA_DB_PATH=./study_db
SQLITE_DB_PATH=./omnischolar.db

# ── App ─────────────────────────────────────────────────────────────────────
# True shows full tracebacks in the UI
APP_DEBUG=False
DEFAULT_LANGUAGE=english

# ── Optional: only used by the training/upload scripts ─────────────────────
HUGGINGFACE_TOKEN=
HUGGINGFACE_REPO=kowshikan/omnischolar-gemma4-edu
